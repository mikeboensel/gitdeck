{
  "name": "gitdeck",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Local multi-account dashboard for GitHub and Forgejo-compatible forges (Codeberg, self-hosted).",
  "packageManager": "pnpm@9.15.9",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "concurrently \"pnpm:api\" \"vite --host 127.0.0.1\"",
    "api": "tsx watch src/server.ts",
    "build": "pnpm build:web",
    "build:web": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js && vite build",
    "preview:web": "vite preview --host 127.0.0.1",
    "start": "pnpm start:web",
    "start:web": "node dist/server.js",
    "serve:web": "node dist/server.js",
    "dev:electron": "concurrently \"vite --host 127.0.0.1\" \"electron-vite dev --watch\"",
    "build:electron": "electron-vite build",
    "package:electron": "vite build && electron-vite build && electron-builder",
    "package:electron:dir": "vite build && electron-vite build && electron-builder --dir",
    "typecheck:electron": "tsc --noEmit -p tsconfig.node.json",
    "test:e2e:electron": "playwright test -c playwright.electron.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "kill-ports": "./scripts/kill-dev-ports.sh",
    "prepare": "husky",
    "version": "node scripts/sync-version.js && conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md src/version.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "config": {
    "ports": {
      "web": 5180,
      "api": 8765
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "@hono/node-server": "^2.0.6",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.12.26",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-vite": "^5.0.0",
    "electron-builder": "^25.1.8",
    "@playwright/test": "^1.49.1",
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
