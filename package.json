{
  "name": "gitdeck",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Local multi-account dashboard for GitHub and Forgejo-compatible forges (Codeberg, self-hosted).",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "api": "tsx watch src/server.ts",
    "dev": "concurrently \"pnpm:api\" \"vite --host 127.0.0.1\"",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "kill-ports": "./scripts/kill-dev-ports.sh",
    "prepare": "husky",
    "version": "node scripts/sync-version.js && conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md src/version.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "config": {
    "ports": {
      "web": 5180,
      "api": 8765
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.12.26",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
