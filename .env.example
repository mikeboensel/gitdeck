# Gitdeck environment configuration.
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.

# --- GitHub authentication ---
# OAuth Device Flow client id (for interactive sign-in), or use GITHUB_TOKEN.
GITHUB_CLIENT_ID=
# Personal access token (alternative to OAuth, e.g. for headless/CI use).
GITHUB_TOKEN=
# Auth mode selector (oauth | token | gh-cli). Aliases: GH_AUTH_MODE, GITHUB_MODE.
GITHUB_AUTH_MODE=
# Space-separated OAuth scopes to request (defaults applied if empty).
GITHUB_OAUTH_SCOPES=

# --- OpenAI (optional — enables the AI digest narrative) ---
OPENAI_API_KEY=
OPENAI_DIGEST_MODEL=

# --- Server ---
HOST=0.0.0.0
PORT=8765
LOG_LEVEL=info
